{
	"id": "nodebb-plugin-chattodo-forum",
	"name": "LinX Forum Tweaks",
	"description": "论坛侧薄逻辑：功能建议按票排序、新话题推送团队 IM 中转、状态标签仅 staff 可打。",
	"url": "https://bbs.chattodo.local",
	"hooks": [
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "filter:categories.buildTopicsSortedSet", "method": "forceSuggestionSort" },
		{ "hook": "action:topic.post", "method": "relayNewTopic" },
		{ "hook": "filter:topic.post", "method": "gateStatusTagsOnCreate" },
		{ "hook": "filter:topic.edit", "method": "gateStatusTagsOnEdit" }
	]
}
