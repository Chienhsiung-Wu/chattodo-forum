# VPS 部署凭据模板
# 复制为 .env.deploy，填入真实值。.env.deploy 已被 .gitignore 忽略，不会提交到仓库。
#
# 用法：npm run deploy
#
# 前置条件：
#   1. VPS 以上已按 DEPLOY.md 完成首次部署（Node/Postgres/systemd/Caddy 均已就绪）
#   2. 本机安装了 plink.exe（PuTTY 命令行工具），且该路径在 PATH 中或用 PLINK_BIN 指定
#   3. 当前分支已关联 origin（用于 git push）

VPS_IP=
VPS_USER=root
VPS_PASSWORD=
VPS_PROJECT_DIR=/opt/chattodo-forum
VPS_BRANCH=master

# 可选：手动指定 plink 路径（默认用 PATH 中的 plink）
# PLINK_BIN=D:\software\putty\plink.exe
