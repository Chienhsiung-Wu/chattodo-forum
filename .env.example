# 灵信论坛 — 服务器部署环境变量样例
# 用法：复制为 .env，按实际值填写；deploy 脚本 / systemd 会读取它。
# 注意：.env 含密码，切勿提交到 git（已在 .gitignore 忽略）。

# ── 公网访问 ──────────────────────────────────────────────
# NodeBB 对外的正式地址（Caddy 反代的域名）。决定 Cookie 作用域 / CSRF / socket.io。
NBB_URL=https://forum.example.com

# NodeBB 本地监听端口（只在 127.0.0.1，由 Caddy 反代，不直接对外）
NBB_PORT=4567

# ── 数据库（持久化 Postgres）────────────────────────────────
# 生产务必用强密码，且 Postgres 只在内网/本机监听。
PGHOST=127.0.0.1
PGPORT=5432
DBNAME=nodebb
DBUSER=nodebb
DBPASS=CHANGE_ME_strong_db_password

# docker-compose 拉起 Postgres 时映射到宿主的端口（与 PGPORT 保持一致；被占用可改）
PG_HOST_PORT=5432

# ── 管理员（仅首次 setup 生效）──────────────────────────────
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ── SSO（本次先不接真实 App 登录）──────────────────────────
# 纯浏览上线可留空/不启动 mock SSO。日后接真实 App OAuth2 后端时再填：
# SSO_BASE=https://app-backend.example.com/oauth
# SSO_CLIENT_ID=your_client_id
# SSO_CLIENT_SECRET=your_client_secret

# ── 团队 IM 通知（可选）────────────────────────────────────
# 接真实飞书/钉钉/企微/Slack 机器人时填其 webhook；留空则用 mock 或不推送。
# IM_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
